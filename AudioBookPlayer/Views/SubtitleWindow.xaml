<Window x:Class="AudioBookPlayer.Views.SubtitleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AudioBookPlayer.Controls"
        Title="AudioBookPlayer.SubtitleOverlay"
        Width="1400" Height="220"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="False"
        UseLayoutRounding="False"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="Grayscale">

    <!-- 解锁拖动时 IsHitTestVisible 变 true，鼠标消息才进得来；锁定时整窗穿透到下层应用 -->
    <Grid x:Name="RootGrid" Background="Transparent"
          IsHitTestVisible="{Binding IsMovable}">

        <!-- 字幕本体：整个窗口除了文字什么都没有 -->
        <!-- 主字幕 + 副字幕（双语）：整体垂直居中，各自水平居中 -->
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" IsHitTestVisible="False">
            <controls:OutlinedTextBlock x:Name="SubtitleText"
                                        Text="{Binding Text}"
                                        FontFamily="{Binding FontFamily}"
                                        FontSize="{Binding FontSize}"
                                        FontWeight="{Binding FontWeight}"
                                        Fill="{Binding Foreground}"
                                        Stroke="{Binding OutlineBrush}"
                                        StrokeThickness="{Binding OutlineThickness}"
                                        TextAlignment="Center"
                                        HorizontalAlignment="Stretch"
                                        IsHitTestVisible="False" />

            <controls:OutlinedTextBlock x:Name="SecondarySubtitleText"
                                        Text="{Binding SecondaryText}"
                                        FontFamily="{Binding FontFamily}"
                                        FontSize="{Binding SecondaryFontSize}"
                                        FontWeight="{Binding FontWeight}"
                                        Fill="{Binding Foreground}"
                                        Stroke="{Binding OutlineBrush}"
                                        StrokeThickness="{Binding OutlineThickness}"
                                        Opacity="0.85"
                                        Margin="0,8,0,0"
                                        TextAlignment="Center"
                                        HorizontalAlignment="Stretch"
                                        IsHitTestVisible="False"
                                        Visibility="{Binding HasSecondaryText, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- 拖动模式：虚线框 + 顶部提示条（只有解锁时才出现） -->
        <Rectangle x:Name="MoveFrame"
                   Stroke="{DynamicResource AccentBrush}"
                   StrokeThickness="2"
                   StrokeDashArray="6 4"
                   RadiusX="10" RadiusY="10"
                   Margin="2"
                   IsHitTestVisible="False"
                   Visibility="{Binding IsMovable, Converter={StaticResource BoolToVisibility}}" />

        <!-- 解锁后可拖动右下 / 左下角改字幕框大小 -->
        <Thumb x:Name="ResizeBottomRight"
               Style="{StaticResource OverlayResizeThumbStyle}"
               HorizontalAlignment="Right" VerticalAlignment="Bottom"
               DragStarted="OnResizeDragStarted"
               DragDelta="OnResizeDragDelta"
               DragCompleted="OnResizeDragCompleted"
               Visibility="{Binding IsMovable, Converter={StaticResource BoolToVisibility}}" />

        <Thumb x:Name="ResizeBottomLeft"
               Style="{StaticResource OverlayResizeThumbStyle}"
               HorizontalAlignment="Left" VerticalAlignment="Bottom"
               Cursor="SizeNESW"
               DragStarted="OnResizeDragStarted"
               DragDelta="OnResizeDragDelta"
               DragCompleted="OnResizeDragCompleted"
               Visibility="{Binding IsMovable, Converter={StaticResource BoolToVisibility}}" />

        <Border x:Name="MoveHint"
                VerticalAlignment="Top" HorizontalAlignment="Center"
                Margin="0,8,0,0"
                Padding="14,7"
                CornerRadius="10"
                Background="#E6121011"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                Visibility="{Binding IsMovable, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="拖动移动　·　滚轮调字号　·　拖角改大小"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           FontFamily="Microsoft YaHei UI, Segoe UI"
                           FontSize="13"
                           VerticalAlignment="Center" />
                <Button x:Name="LockButton"
                        Content="完成"
                        Margin="14,0,0,0"
                        Padding="12,3"
                        Click="OnLockClick"
                        Cursor="Hand" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
