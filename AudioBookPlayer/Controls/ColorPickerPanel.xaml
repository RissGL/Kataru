<UserControl x:Class="AudioBookPlayer.Controls.ColorPickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="248">

    <!--
        自绘调色盘：上面是"饱和度 × 明度"方块（色相由下面那条彩色带决定），
        下面是色相带 + 十六进制输入。点住拖动即可取色。
        放在 Popup 里用，点外面会自动关闭。
    -->
    <StackPanel>
        <!-- 饱和度 / 明度 方块 -->
        <Border CornerRadius="6" ClipToBounds="True" BorderThickness="0">
            <Canvas x:Name="SvCanvas" Height="152" Background="Transparent"
                    MouseLeftButtonDown="OnSvMouseDown"
                    MouseMove="OnSvMouseMove"
                    MouseLeftButtonUp="OnSvMouseUp"
                    Cursor="Cross">
                <!-- 底色 = 当前色相 -->
                <Rectangle x:Name="HueLayer" Canvas.Left="0" Canvas.Top="0" Width="248" Height="152" />
                <!-- 横向：左白 → 右透明（饱和度） -->
                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="248" Height="152">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- 纵向：上透明 → 下黑（明度） -->
                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="248" Height="152">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- 取色点 -->
                <Ellipse x:Name="SvThumb" Width="14" Height="14" Stroke="White" StrokeThickness="2"
                         Fill="Transparent" IsHitTestVisible="False">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" />
                    </Ellipse.Effect>
                </Ellipse>
            </Canvas>
        </Border>

        <!-- 色相带 -->
        <Canvas x:Name="HueCanvas" Height="18" Margin="0,10,0,0" Background="Transparent"
                MouseLeftButtonDown="OnHueMouseDown"
                MouseMove="OnHueMouseMove"
                MouseLeftButtonUp="OnHueMouseUp"
                Cursor="Hand">
            <Border Canvas.Left="0" Canvas.Top="4" Width="248" Height="10" CornerRadius="5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FFFF0000" Offset="0" />
                        <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                        <GradientStop Color="#FF00FF00" Offset="0.3333" />
                        <GradientStop Color="#FF00FFFF" Offset="0.5" />
                        <GradientStop Color="#FF0000FF" Offset="0.6667" />
                        <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                        <GradientStop Color="#FFFF0000" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Ellipse x:Name="HueThumb" Width="16" Height="16" Stroke="White" StrokeThickness="2"
                     Fill="#FF888888" IsHitTestVisible="False">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.6" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <!-- 预览 + 十六进制 -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="PreviewBorder" Grid.Column="0" Width="46" Height="30" CornerRadius="6"
                    BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" />

            <TextBox x:Name="HexBox" Grid.Column="1" Margin="8,0,0,0" VerticalContentAlignment="Center"
                     KeyDown="OnHexKeyDown" LostKeyboardFocus="OnHexCommit"
                     ToolTip="也可以直接填十六进制，例如 #9E2B25" />
        </Grid>
    </StackPanel>
</UserControl>
